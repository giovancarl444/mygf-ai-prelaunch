# /etc/caddy/Caddyfile
#
# TLS is issued and renewed automatically, which is the entire reason Caddy is
# here rather than nginx.
#
# No domain yet? Use `<droplet-ip-with-dashes>.sslip.io` — it resolves to the
# address in the name, so a real certificate is issued with nothing to
# register. That is enough to deploy and test everything today, and the only
# change when the real domain lands is this line and PUBLIC_BASE_URL.
#
#   203-0-113-9.sslip.io {

mygf.example.com {
	encode zstd gzip

	# Hashed asset filenames are immutable; the HTML shell is not, because the
	# per-route metadata is written into it on every request.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The provider's media is served from presigned S3 URLs, so those hosts
		# have to be reachable for images, audio, and video to render.
		-Server
	}

	reverse_proxy 127.0.0.1:3000
}
