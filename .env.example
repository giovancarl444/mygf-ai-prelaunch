# Copy to /srv/mygf/.env on the server. Never committed, never in the bundle.

NODE_ENV=production
PORT=3000

# The public origin. Set this and canonical URLs, the sitemap, and robots.txt
# all follow it; leave it unset and they follow whatever host served the
# request, which is right in development and wrong behind a proxy.
PUBLIC_BASE_URL=https://example.com

# DigitalOcean managed MySQL. Use the private-network host so the traffic never
# leaves the VPC, and keep sslmode required.
# Paste the provider's VPC connection string exactly as given, ?ssl-mode=REQUIRED
# and all — that parameter is what turns encryption on.
DATABASE_URL=mysql://user:password@private-host:25060/defaultdb?ssl-mode=REQUIRED

# Only needed if the database's certificate is not signed by a publicly trusted
# authority. A PEM, or a path to one. DigitalOcean offers it on the database
# Overview page as "Download CA certificate".
DATABASE_CA_CERT=

# Server-only. Never in a bundle, a log, an audit row, or a customer-facing
# error — see CLAUDE.md.
OHAPI_API_KEY=

# Session signing. Rotating this signs everyone out, which is the point.
JWT_SECRET=

# The account that may reach /ops/ohapi.
OWNER_OPEN_ID=

# Sending the sign-in link. `log` prints it to the server log instead, which is
# what makes local development work with no account anywhere.
EMAIL_PROVIDER=log        # log | resend | postmark
EMAIL_API_KEY=
EMAIL_FROM="MyGF.ai <hello@example.com>"

# Any non-empty string. It is stamped into the session JWT and checked for
# presence, not compared against anything, so it no longer has to come from the
# platform that used to issue it.
VITE_APP_ID=mygf

# The old identity provider. Only needed while accounts created through it are
# still signing in that way; sign-in itself no longer depends on either.
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
